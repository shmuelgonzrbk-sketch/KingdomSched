generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  googleId      String         @unique
  email         String         @unique
  nombre        String
  foto          String?
  rol           String         @default("user")
  createdAt     DateTime       @default(now())
  schedules     Schedule[]
  participantes Participante[]
  grupos        Grupo[]
  config        Config?
  bosquejosPersonales BosquejoPersonal[]
  congregacionId String?
  congregacion   Congregacion? @relation(fields: [congregacionId], references: [id])
}

model Congregacion {
  id                String   @id @default(cuid())
  nombre            String
  codigo            String   @unique
  creadorId         String?
  metaAccessToken   String?
  metaPhoneNumberId String?
  whatsappActivo    Boolean  @default(false)
  createdAt         DateTime @default(now())
  users             User[]
  invitaciones      InvitacionCongregacion[]
}
model InvitacionCongregacion {
  id             String       @id @default(cuid())
  token          String       @unique
  congregacionId String
  congregacion   Congregacion @relation(fields: [congregacionId], references: [id])
  usado          Boolean      @default(false)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
}
model Bosquejo {
  id        Int      @id
  tema      String
  activo    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Participante {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nombre    String
  tipo      String
  orden     Int
  telefono  String?
  createdAt DateTime @default(now())
  @@unique([userId, nombre, tipo])
}

model Grupo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nombre    String
  orden     Int
  createdAt DateTime @default(now())
}

model Schedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  fecha        String
  presidente   String?
  orador       String?
  oradorZoom   Boolean  @default(false)
  bosquejoId   Int?
  tema         String?
  lector       String?
  hospitalidad String?
  eventType    String?
  orden        Int
  createdAt    DateTime @default(now())
}

model Config {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  meetingDay Int
  updatedAt  DateTime @updatedAt
}

model DiscursoEspecial {
  id        String   @id @default(cuid())
  tema      String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BosquejoPersonal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tema      String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}
